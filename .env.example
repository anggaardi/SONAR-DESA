# Names only. Real values live in .env (local, gitignored) and .env.production (server, chmod 600).
# Local defaults below match compose.dev.yml and are dev-only.

# ── App
APP_NAME="Sonar Desa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
# Store UTC, display WITA (decision A14).
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=Asia/Makassar
GIT_COMMIT=dev

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ── Database (Postgres also backs queue, cache, session: decision A10)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sonar
DB_USERNAME=sonar
DB_PASSWORD=sonar_dev_only
DB_FORWARD_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# ── RAB reader (PRD Arsitektur 6.5)
RAB_READER=fixture
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
RAB_READ_TIMEOUT_SECONDS=60
AI_DAILY_READ_LIMIT=150
AI_DEMO_DAILY_READ_LIMIT=60

# ── Google login for warga (Socialite, module M4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ── Product rules (config/sonar.php; calibrated in QF2-QF4)
REPORT_RADIUS_M=300
REPORT_MAX_ACCURACY_M=100
REVIEW_THRESHOLD=3
PRICE_ROW_TOLERANCE_RP=1000
DEMO_UPLOAD_LIMIT=3
DEMO_TTL_HOURS=24

# ── Production only
DOMAIN=
QUEUE_WORKERS=3

VITE_APP_NAME="${APP_NAME}"
