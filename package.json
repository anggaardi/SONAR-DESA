{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run --passWithNoTests",
        "lint": "eslint . --max-warnings=0 && prettier --check resources/js resources/css",
        "format": "eslint . --fix && prettier --write resources/js resources/css",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "~3.11.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.0.0",
        "vitest": "^5.1.1",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "~3.11.0",
        "vue": "~3.5.0"
    }
}
