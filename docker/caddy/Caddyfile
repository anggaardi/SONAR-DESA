# SITE_ADDRESS is ":80" in dev (plain HTTP on localhost) and the domain in prod (automatic HTTPS).
{$SITE_ADDRESS::80} {
	root * /var/www/html/public
	encode zstd gzip

	# Same limit as php.ini post_max_size, so oversized uploads fail here with 413.
	request_body {
		max_size 16MB
	}

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	php_fastcgi {$PHP_UPSTREAM:app:9000}
	file_server
}
